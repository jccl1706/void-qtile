# GENERATED BY bin/theme.sh FROM themes/nord.conf - DO NOT EDIT.
# Edit the palette and run bin/theme.sh again; this file is overwritten.

[global]
    # follow=none with an explicit monitor: this machine has one display, and
    # "follow the mouse" puts notifications wherever the pointer happens to be.
    follow = none
    monitor = 0

    origin = top-right
    offset = 12x48
    # 48 clears the 34px bar plus its margin, so a notification never lands on
    # top of the clock.

    width = (320, 520)
    height = (0, 300)
    scale = 0

    frame_width = 2
    corner_radius = 8
    gap_size = 6
    padding = 12
    horizontal_padding = 14

    font = DejaVu Sans 11
    markup = full
    format = "<b>%s</b>\n%b"
    word_wrap = yes

    icon_position = left
    min_icon_size = 32
    max_icon_size = 64

    mouse_left_click = close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all

[urgency_low]
    background = "#3b4252"
    foreground = "#d8dee9"
    frame_color = "#4c566a"
    timeout = 5

[urgency_normal]
    background = "#3b4252"
    foreground = "#eceff4"
    frame_color = "#88c0d0"
    timeout = 8

[urgency_critical]
    # NO TIMEOUT: a critical notification that disappears on its own is one you
    # were not at the machine to see.
    background = "#3b4252"
    foreground = "#eceff4"
    frame_color = "#bf616a"
    timeout = 0
